# GRC Agent Local Client - Environment Configuration
# Copy this file to ".env" and fill in your Turso credentials.

# Turso cloud database URL (libsql:// format)
TURSO_URL=libsql://your-db-name-your-org.turso.io

# Turso auth token
TURSO_TOKEN=your-turso-token-here

# Optional: override LLM settings (defaults are in config.yaml)
# LLM_API_KEY=your-llm-api-key
